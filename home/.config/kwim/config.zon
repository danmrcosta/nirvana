.{
    .libinput_device_rules = .{
        .{
            .name = .{ .str = "SynPS/2 Synaptics TouchPad" },
            .tap = .enabled,
            .natural_scroll = .enabled,
        },
    },

    .xkb_keyboard_rules = .{
        .{
            .keymap = .{
                .options = .{
                    .layout = "us",
                    .variant = "intl",
                },
            },
        },
    },
}
