theme {
    accent-color "#1565C0"
}

allow-exit-session #true

shells {
    enabled #true
    active "waybar"
    cycle "waybar"

    profile "waybar" {
        launch "waybar"
        stop "pkill" "-x" "waybar"
        niri-compat #true   // necessário: o módulo de workspaces do Waybar lê o socket compatível com o niri
    }
}

environment {
    LIBVA_DRIVER_NAME "radeonsi"
    VDPAU_DRIVER "radeon"
    AMD_VULKAN_ICD "RADV"
    XCURSOR_SIZE "24"
}

output "eDP-1" {
    scale 1.25
}

terminal {
    command "alacritty"
}

layout {
    gaps 5
    center-focused-column "on-overflow"
    default-column-width { proportion 0.5; }
    master {
        count 1
        split-ratio 0.55
    }
    border {
        width 2
        active-color "#1565C0"
        inactive-color "#3A3A3A"
    }
    smart-gaps #false
    enable-animations #true
    layout-cycle "dwindle" "tile" "grid" "monocle" "deck" "scroller"
}

workspaces {
    default-count 9
    default-layout "scroller"
}

input {
    keyboard {
        xkb {
            layout "us"
            variant "intl"
        }
    }
    touchpad {
        tap
        natural-scroll
    }
}

screenshot {
    directory "~/Pictures/Screenshots"
    filename-prefix "screenshot"
    capture-command "grim"
    region-selector-command "slurp"
    clipboard-command "wl-copy"
    show-pointer #false
}

spawn-at-startup "swaybg" "-m" "fill" "-i" "/home/dan/Pictures/upscalemedia-transformed.png"
spawn-at-startup "gammastep" "-O" "4000"
spawn-at-startup "hypridle"

bindings {
    mirror-hjkl-arrows #true

    // Sessão
    bind "Super+Shift+e" "exit-session" allow-inhibiting=#false
    bind "Ctrl+Alt+Delete" "exit-session" allow-inhibiting=#false
 
    // Apps
    bind "Super+Return" "spawn alacritty"
    bind "Super+d"      "spawn rofi -show drun"
    bind "Super+e"      "spawn pcmanfm"

    // Janela
    bind "Super+Shift+q" "close-window"
    bind "Super+f"        "toggle-maximized"
    bind "Super+Shift+f"  "fullscreen-window"
    bind "Super+space"    "toggle-floating"
    bind "Super+Shift+m"  "maximize-column"

    // Foco direcional (igual movefocus do Hyprland)
    bind "Super+h" "focus-left"
    bind "Super+l" "focus-right"
    bind "Super+k" "focus-up"
    bind "Super+j" "focus-down"

    // Mover janela (igual movewindow do Hyprland — substitui move-workspace-to-output)
    bind "Super+Shift+h" "move-window-left"
    bind "Super+Shift+l" "move-window-right"
    bind "Super+Shift+k" "move-window-up"
    bind "Super+Shift+j" "move-window-down"

    // Resize / mfact (substitui move-window nesses slots)
    bind "Super+Ctrl+l" "adjust-master-ratio 0.02"
    bind "Super+Ctrl+h" "adjust-master-ratio -0.02"

    // Tags/workspaces
    bind "Super+1" "focus-workspace 1"
    bind "Super+2" "focus-workspace 2"
    bind "Super+3" "focus-workspace 3"
    bind "Super+4" "focus-workspace 4"
    bind "Super+5" "focus-workspace 5"
    bind "Super+6" "focus-workspace 6"
    bind "Super+7" "focus-workspace 7"
    bind "Super+8" "focus-workspace 8"
    bind "Super+9" "focus-workspace 9"
    bind "Super+Ctrl+1" "move-to-workspace 1"
    bind "Super+Ctrl+2" "move-to-workspace 2"
    bind "Super+Ctrl+3" "move-to-workspace 3"
    bind "Super+Ctrl+4" "move-to-workspace 4"
    bind "Super+Ctrl+5" "move-to-workspace 5"
    bind "Super+Ctrl+6" "move-to-workspace 6"
    bind "Super+Ctrl+7" "move-to-workspace 7"
    bind "Super+Ctrl+8" "move-to-workspace 8"
    bind "Super+Ctrl+9" "move-to-workspace 9"
    bind "Super+Tab"    "focus-last"

    // Layouts (igual seu esquema s/t/g/shift+d/m)
    bind "Super+s"       "scroller"
    bind "Super+t"       "tile"
    bind "Super+g"       "grid"
    bind "Super+Shift+d" "deck"
    bind "Super+m"       "monocle"
    bind "Super+n"       "switch-layout"
    bind "Super+grave"   "switch-layout"

    // Scratchpad (migrado do Super+s original do Triad)
    bind "Super+Ctrl+s" "move-to-scratchpad"
    bind "Super+Alt+s"  "toggle-scratchpad"

    // Screenshots (nativo — troca seus scripts .sh)
    bind "Print"          "screenshot-screen"
    bind "Super+Shift+s"  "screenshot"
    bind "Super+Print"    "screenshot --clipboard-only"

    // Volume / brilho
    bind "XF86AudioRaiseVolume"   "spawn wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+"
    bind "XF86AudioLowerVolume"   "spawn wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    bind "XF86AudioMute"          "spawn wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    bind "XF86MonBrightnessUp"    "spawn brightnessctl set 5%+" 
    bind "XF86MonBrightnessDown"  "spawn brightnessctl set 5%-"

    layout "dwindle" {
        bind "Super+Alt+h" "dwindle-split-left"
        bind "Super+Alt+j" "dwindle-split-down"
        bind "Super+Alt+k" "dwindle-split-up"
        bind "Super+Alt+l" "dwindle-split-right"
    }

    pointer-bind "Super+left"  "move"
    pointer-bind "Super+right" "resize"
}

window-rule {
    match app-id="^rofi$"
    open-floating #true
}
window-rule {
    match app-id="^zenity$"
    open-floating #true
}
window-rule {
    match app-id="^pavucontrol$"
    open-floating #true
}
window-rule {
    match app-id="^xdg-desktop-portal-gtk$"
    open-floating #true
}
