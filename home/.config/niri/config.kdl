// ╭──────────────────────────────────────────────────────────────────────────────╮
// │ Niri configuration                                                          │
// │ Baseado no config padrão do Niri — versão otimizada para performance        │
// ╰──────────────────────────────────────────────────────────────────────────────╯


// ╭──────────────────────────────────────────────────────────────────────────────╮
// │ CSD (client-side decorations)                                               │
// ╰──────────────────────────────────────────────────────────────────────────────╯

// Pede para os apps NÃO desenharem a própria titlebar/borda (GTK/libadwaita
// costumam desenhar uma barra branca em cima quando isso não é setado).
// Nem todo app respeita 100%, mas resolve a grande maioria dos casos.
prefer-no-csd


// ╭──────────────────────────────────────────────────────────────────────────────╮
// │ Environment                                                                 │
// ╰──────────────────────────────────────────────────────────────────────────────╯

// Força tema escuro em apps GTK/Qt — ajuda quando algum app ainda insiste
// em desenhar CSD própria (fica escura em vez de branca).
environment {
    GTK_THEME "Adwaita:dark"
    // QT_QPA_PLATFORMTHEME "qt5ct"
}


// ╭──────────────────────────────────────────────────────────────────────────────╮
// │ Input                                                                       │
// ╰──────────────────────────────────────────────────────────────────────────────╯

input {
    keyboard {
        xkb {
            layout "us"
            variant "intl"
        }

        // Numlock
        numlock
    }

    touchpad {
        // Tap to click.
        tap

        // Natural scrolling.
        natural-scroll
    }

    mouse {
        // Enable or disable mouse acceleration.
        // accel-speed 0.0
    }

    // Focus windows when mouse enters them.
    // focus-follows-mouse
}


// ╭──────────────────────────────────────────────────────────────────────────────╮
// │ Outputs                                                                     │
// ╰──────────────────────────────────────────────────────────────────────────────╯

// A tela é configurada por máquina em maquina.kdl, gerado pelo script
// ~/.local/bin/niri-hardware (detecta resolução, refresh máximo, escala
// pelo tamanho real da tela e se a GPU é AMD, Intel ou NVIDIA).
// Trocou de notebook ou de modo da MUX? Rode: niri-hardware
include "maquina.kdl"


// ╭──────────────────────────────────────────────────────────────────────────────╮
// │ Workspaces fixos                                                            │
// ╰──────────────────────────────────────────────────────────────────────────────╯

// Por padrão o niri cria/destrói workspaces dinamicamente (por isso o 3 só
// aparecia depois de abrir o 2). Declarando-os aqui, eles sempre existem —
// e o módulo niri/workspaces do waybar passa a mostrar todos, sempre.
workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "5"
workspace "6"
workspace "7"
workspace "8"
workspace "9"


// ╭──────────────────────────────────────────────────────────────────────────────╮
// │ Layout                                                                      │
// ╰──────────────────────────────────────────────────────────────────────────────╯

layout {
    // Menor que o padrão para ficar parecido com sua configuração anterior.
    gaps 5

    // Mantém a coluna focada centralizada quando necessário.
    center-focused-column "never"

    // Presets de largura padrão.
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    // Largura padrão de uma coluna.
    default-column-width {
        proportion 0.5
    }

    // Focus ring.
    focus-ring {
        // Deixamos o focus ring ligado, como no padrão do Niri.
        width 2

        // Azul parecido com sua configuração antiga.
        active-color "#0000ff"

        // cor cinza da janela inativa
        inactive-color "#3A3A3A"
    }

    // Border desligada para evitar renderização visual desnecessária.
    // O focus-ring acima funciona como indicador da janela ativa.
    border {
        off
    }

    // Shadow desligado = menos trabalho de renderização.
    shadow {
        off
    }

    // Espaço reservado para barras/painéis.
    struts {
    }
}


// ╭──────────────────────────────────────────────────────────────────────────────╮
// │ Cursor                                                                      │
// ╰──────────────────────────────────────────────────────────────────────────────╯

cursor {
    // Some com o cursor enquanto digita — menos redraw.
    hide-when-typing
}


// ╭──────────────────────────────────────────────────────────────────────────────╮
// │ Startup                                                                     │
// ╰──────────────────────────────────────────────────────────────────────────────╯

// Sua Waybar.
spawn-at-startup "waybar"

// Seu wallpaper.
spawn-at-startup "sh" "-c" "swaybg -m fill -i ~/.local/share/wallpapers/walpaper2.jpeg"

// Temperatura de cor.
spawn-at-startup "sh" "-c" "sleep 1 && gammastep -O 4000"

// Idle: tranca em 5 min, desliga a tela em 10 min, tranca antes de suspender.
spawn-at-startup "swayidle" "-w" "timeout" "300" "swaylock -f" "timeout" "600" "niri msg action power-off-monitors" "before-sleep" "swaylock -f"

// Agente polkit (janela de senha para apps que pedem root).
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"

// ╭──────────────────────────────────────────────────────────────────────────────╮
// │ Hotkey overlay                                                              │
// ╰──────────────────────────────────────────────────────────────────────────────╯

hotkey-overlay {
    skip-at-startup
}


// ╭──────────────────────────────────────────────────────────────────────────────╮
// │ Screenshots                                                                 │
// ╰──────────────────────────────────────────────────────────────────────────────╯

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"


// ╭──────────────────────────────────────────────────────────────────────────────╮
// │ Animations                                                                  │
// ╰──────────────────────────────────────────────────────────────────────────────╯

// Desligado para máxima responsividade.
// Isso reduz efeitos visuais e deixa as transições instantâneas.
animations {
    off
}


// ╭──────────────────────────────────────────────────────────────────────────────╮
// │ Window rules                                                                │
// ╰──────────────────────────────────────────────────────────────────────────────╯

window-rule {
    // Corner radius já é 0 por padrão (sem essa linha). Deixe descomentado
    // só se algum app específico continuar mostrando canto arredondado
    // via CSD própria — nesse caso, combine com clip-to-geometry.
    // geometry-corner-radius 0
    // clip-to-geometry true
}

// Jogos (Steam/Proton): ativa o VRR da tela só nessas janelas.
window-rule {
    match app-id=r#"^steam_app_"#
    match app-id=r#"^gamescope$"#
    variable-refresh-rate true
}

// Terminal flutuante (usado pelo bind Super+Shift+Return abaixo).
window-rule {
    match app-id="floating-term"
    open-floating true
    default-column-width { proportion 0.4; }
}


// ╭──────────────────────────────────────────────────────────────────────────────╮
// │ Keybinds                                                                    │
// ╰──────────────────────────────────────────────────────────────────────────────╯

binds {

    // ─────────────────────────────────────────────────────────────────────────
    // Terminal / aplicativos
    // ─────────────────────────────────────────────────────────────────────────

    // Seu Super + Enter
    Super+Return {
        spawn "alacritty"
    }

    // Terminal flutuante rápido (notas, comandos avulsos).
    Super+Shift+Return {
        spawn "alacritty" "--class" "floating-term"
    }

    // Seu Super + D
    // Rofi em vez do Fuzzel padrão.
    Super+D {
        spawn "rofi" "-show" "drun"
    }

    // Seu Super + E
    Super+E {
        spawn "pcmanfm"
    }

    // Navegador — ajuste para o binário do seu browser (firefox, chromium, etc).
    Super+B {
        spawn "firefox"
    }

    // Menu de power/logout (precisa ter o wlogout instalado).
    // Super+Escape {
    //     spawn "wlogout"
    // }


    // ─────────────────────────────────────────────────────────────────────────
    // Fechar / sair
    // ─────────────────────────────────────────────────────────────────────────

    // Fechar janela
    Super+Shift+Q {
        close-window
    }

    // Sair do Niri
    Super+Shift+E {
        quit
    }

    // Alternativa para sair
    Ctrl+Alt+Delete {
        quit
    }


    // ─────────────────────────────────────────────────────────────────────────
    // HJKL — navegação
    // ─────────────────────────────────────────────────────────────────────────

    // Esquerda
    Super+H {
        focus-column-left
    }

    // Baixo
    Super+J {
        focus-window-down
    }

    // Cima
    Super+K {
        focus-window-up
    }

    // Direita
    Super+L {
        focus-column-right
    }


    // ─────────────────────────────────────────────────────────────────────────
    // HJKL — mover janelas
    // ─────────────────────────────────────────────────────────────────────────

    // Mover coluna para esquerda
    Super+Shift+H {
        move-column-left
    }

    // Mover janela para baixo
    Super+Shift+J {
        move-window-down
    }

    // Mover janela para cima
    Super+Shift+K {
        move-window-up
    }

    // Mover coluna para direita
    Super+Shift+L {
        move-column-right
    }


    // ─────────────────────────────────────────────────────────────────────────
    // Janelas
    // ─────────────────────────────────────────────────────────────────────────

    // Maximizar coluna
    Super+F {
        maximize-column
    }

    // Fullscreen
    Super+Shift+F {
        fullscreen-window
    }

    // Maximizar janela até as bordas
    Super+M {
        maximize-window-to-edges
    }

    // Floating
    Super+Space {
        toggle-window-floating
    }

    // Centralizar coluna
    Super+C {
        center-column
    }


    // ─────────────────────────────────────────────────────────────────────────
    // Workspaces — números
    // ─────────────────────────────────────────────────────────────────────────

    Super+1 {
        focus-workspace "1"
    }

    Super+2 {
        focus-workspace "2"
    }

    Super+3 {
        focus-workspace "3"
    }

    Super+4 {
        focus-workspace "4"
    }

    Super+5 {
        focus-workspace "5"
    }

    Super+6 {
        focus-workspace "6"
    }

    Super+7 {
        focus-workspace "7"
    }

    Super+8 {
        focus-workspace "8"
    }

    Super+9 {
        focus-workspace "9"
    }


    // ─────────────────────────────────────────────────────────────────────────
    // Workspaces — navegação vertical rápida (setas / scroll)
    // ─────────────────────────────────────────────────────────────────────────

    Super+Down {
        focus-workspace-down
    }

    Super+Up {
        focus-workspace-up
    }

    Super+WheelScrollDown {
        focus-workspace-down
    }

    Super+WheelScrollUp {
        focus-workspace-up
    }


    // ─────────────────────────────────────────────────────────────────────────
    // Mover janela/coluna para workspace
    // ─────────────────────────────────────────────────────────────────────────

    Super+Shift+1 {
        move-column-to-workspace "1"
    }

    Super+Shift+2 {
        move-column-to-workspace "2"
    }

    Super+Shift+3 {
        move-column-to-workspace "3"
    }

    Super+Shift+4 {
        move-column-to-workspace "4"
    }

    Super+Shift+5 {
        move-column-to-workspace "5"
    }

    Super+Shift+6 {
        move-column-to-workspace "6"
    }

    Super+Shift+7 {
        move-column-to-workspace "7"
    }

    Super+Shift+8 {
        move-column-to-workspace "8"
    }

    Super+Shift+9 {
        move-column-to-workspace "9"
    }

    Super+Shift+Down {
        move-column-to-workspace-down
    }

    Super+Shift+Up {
        move-column-to-workspace-up
    }


    // ─────────────────────────────────────────────────────────────────────────
    // Workspace anterior
    // ─────────────────────────────────────────────────────────────────────────

    Super+Tab {
        focus-workspace-previous
    }


    // ─────────────────────────────────────────────────────────────────────────
    // Largura das colunas
    // ─────────────────────────────────────────────────────────────────────────

    Super+R {
        switch-preset-column-width
    }

    Super+Ctrl+H {
        set-column-width "-10%"
    }

    Super+Ctrl+L {
        set-column-width "+10%"
    }

    Super+Ctrl+J {
        set-window-height "-10%"
    }

    Super+Ctrl+K {
        set-window-height "+10%"
    }


    // ─────────────────────────────────────────────────────────────────────────
    // Layout / colunas
    // ─────────────────────────────────────────────────────────────────────────

    // Expelir janela para virar uma nova coluna
    Super+BracketLeft {
        consume-or-expel-window-left
    }

    Super+BracketRight {
        consume-or-expel-window-right
    }


    // ─────────────────────────────────────────────────────────────────────────
    // Volume
    // ─────────────────────────────────────────────────────────────────────────

    XF86AudioRaiseVolume {
        spawn-sh "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+"
    }

    XF86AudioLowerVolume {
        spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    }

    XF86AudioMute {
        spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    }


    // ─────────────────────────────────────────────────────────────────────────
    // Brilho
    // ─────────────────────────────────────────────────────────────────────────

    XF86MonBrightnessUp {
        spawn "brightnessctl" "set" "5%+"
    }

    XF86MonBrightnessDown {
        spawn "brightnessctl" "set" "5%-"
    }


    // ─────────────────────────────────────────────────────────────────────────
    // Screenshots
    // ─────────────────────────────────────────────────────────────────────────

    Print {
        screenshot-screen
    }

    Super+Shift+S {
        screenshot
    }

    Super+Shift+Print {
        screenshot-window
    }


    // ─────────────────────────────────────────────────────────────────────────
    // Lock
    // ─────────────────────────────────────────────────────────────────────────

    Super+Alt+L {
        spawn "swaylock"
    }


    // ─────────────────────────────────────────────────────────────────────────
    // Sistema
    // ─────────────────────────────────────────────────────────────────────────
}
